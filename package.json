{
  "name": "mediahub",
  "version": "1.0.0",
  "description": "MediaHub - 热门内容推荐平台",
  "private": true,
  "engines": {
    "node": ">=22 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/run-mediahub-command.mjs dev-backend",
    "dev:frontend": "node scripts/run-mediahub-command.mjs dev-frontend",
    "build": "npm run build --workspace=frontend",
    "start": "node scripts/run-mediahub-command.mjs start-backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "crawl:real": "node scripts/update-real-dataset-catalog.mjs && node scripts/fill-hot-datasets.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
