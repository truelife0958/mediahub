# ─── AI 配置 ───
MEDIAHUB_AI_ENABLED=false
MEDIAHUB_AI_MODEL=
MEDIAHUB_AI_BASE_URL=
MEDIAHUB_AI_API_KEY=
MEDIAHUB_AI_REQUEST_TIMEOUT_MS=90000
MEDIAHUB_INTERACTIVE_AI_SEARCH_TIMEOUT_MS=30000

# ─── 自动刷新 ───
MEDIAHUB_AUTO_REFRESH_ENABLED=false
MEDIAHUB_AUTO_REFRESH_MODE=interval
MEDIAHUB_AUTO_REFRESH_INTERVAL_MINUTES=5
MEDIAHUB_AUTO_REFRESH_FAILURE_BACKOFF_ENABLED=true
MEDIAHUB_AUTO_REFRESH_FAILURE_BACKOFF_MULTIPLIER=2
MEDIAHUB_AUTO_REFRESH_FAILURE_BACKOFF_MAX_MINUTES=60
MEDIAHUB_AUTO_REFRESH_HOUR=3
MEDIAHUB_AUTO_REFRESH_MINUTE=0
MEDIAHUB_AUTO_REFRESH_ON_STARTUP=false

# ─── 入库回填 ───
MEDIAHUB_INGEST_BACKFILL_PAGES=3
MEDIAHUB_INGEST_BACKFILL_PAGE_SIZE=30
MEDIAHUB_INGEST_BACKFILL_SORTS=hot,latest
# MEDIAHUB_INGEST_INCREMENTAL_ENABLED=true
# MEDIAHUB_PLATFORM_SOURCE_ENABLED=false
# MEDIAHUB_BACKFILL_AI_TIMEOUT_MS=20000
# MEDIAHUB_BACKFILL_OVERALL_TIMEOUT_MS=120000

# ─── 缓存与上游 ───
CACHE_TTL_MS=180000
# MEDIAHUB_CATALOG_CACHE_MAX_ENTRIES=500
UPSTREAM_TIMEOUT_MS=12000
UPSTREAM_RETRY_MAX_ATTEMPTS=3
UPSTREAM_RETRY_BASE_DELAY_MS=400
UPSTREAM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
UPSTREAM_CIRCUIT_BREAKER_OPEN_MS=30000
UPSTREAM_RATE_LIMIT_PER_SECOND=6
UPSTREAM_RATE_LIMIT_BURST=6
# UPSTREAM_USER_AGENT=MediaHub/1.0

# ─── 服务端口 ───
# PORT=3001
# HOST=127.0.0.1
# MEDIAHUB_DB_PATH=backend/data/mediahub.sqlite

# ─── 内容显示（可选）───
# MEDIAHUB_HIDE_COVER=设置为任意非空值可隐藏封面图

# ─── Webhook 通知（可选）───
MEDIAHUB_WEBHOOK_NOTIFICATIONS_ENABLED=false
# MEDIAHUB_WEBHOOK_NOTIFICATIONS_SECRET=
MEDIAHUB_WEBHOOK_NOTIFICATIONS_TIMEOUT_MS=5000
MEDIAHUB_WEBHOOK_NOTIFICATIONS_RETRY_MAX_ATTEMPTS=3
MEDIAHUB_WEBHOOK_NOTIFICATIONS_RETRY_BASE_DELAY_MS=500

# ─── 生产环境必填 ───
# MEDIAHUB_ADMIN_PASSWORD=至少12位的强密码
# MEDIAHUB_COOKIE_SECURE=true
# MEDIAHUB_FRONTEND_URL=https://你的前端域名
